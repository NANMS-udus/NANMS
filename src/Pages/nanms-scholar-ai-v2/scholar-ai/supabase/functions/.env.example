# Only for local testing: `npx supabase functions serve scholar-chat --no-verify-jwt --env-file supabase/functions/.env`
# In production set these with: npx supabase secrets set NAME=value

GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated website origins allowed to call the function (leave empty to allow any)
ALLOWED_ORIGINS=https://nanms-2.vercel.app,http://localhost:5173

# Messages allowed per visitor IP per minute
RATE_LIMIT_PER_MINUTE=20
